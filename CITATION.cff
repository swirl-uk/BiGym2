cff-version: 1.2.0
message: "If you use BiGym 2.0 or its demonstration datasets, please cite this software and the original BiGym paper (listed under `references`)."
title: "BiGym 2.0"
type: software
abstract: >-
  BiGym 2.0 is a hard fork of the BiGym demo-driven bi-manual manipulation
  benchmark that replaces the floating-base robot with a whole-body,
  controller-in-the-loop setup: a learned lower-body locomotion policy runs
  inside the environment step, upper-body commands come from VR teleoperation
  or a learned policy, and the benchmark protocol (episode budgets, warmup,
  hold-to-succeed criteria, substrate fingerprints) is recorded per task.
license: Apache-2.0
repository-code: "https://github.com/swirl-uk/BiGym2"
# `version` is the Python package version declared in pyproject.toml. "2.0" in
# the title is the project generation (whole-body fork), not a semver version.
version: "1.0.0"
keywords:
  - robotics
  - humanoid
  - bi-manual manipulation
  - loco-manipulation
  - whole-body control
  - imitation learning
  - benchmark
  - MuJoCo

authors:
  - given-names: Zexi
    family-names: Zhang
  - given-names: Zecheng
    family-names: Zhu
  - given-names: Zidong
    family-names: Chen
  - given-names: Zulkhuu
    family-names: Tuya
  - given-names: Stephen
    family-names: James

preferred-citation:
  type: article
  title: "BiGym 2.0: Benchmarking Learned and Agent-Developed Policies for Humanoid Household Manipulation"
  # Matches the BibTeX entry in README.md; add the venue and DOI once published.
  journal: "arXiv preprint arXiv:2610.07594"
  authors:
    - given-names: Zexi
      family-names: Zhang
